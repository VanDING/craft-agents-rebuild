# Craft Agents — environment configuration example
#
# Copy to .env and adjust. All variables are optional unless marked
# Required — the app works out of the box with source configs + Pi SDK
# connections (Settings → AI).

# ---------------------------------------------------------------------------
# Pi SDK backend (single backend since the Pi migration)
# ---------------------------------------------------------------------------
# LLM provider env vars read by the CLI (`apps/cli`) and Pi API-key flows.
# `pi` is the only providerType; piAuthProvider selects the model catalog
# (anthropic, openai, google, deepseek, openrouter, xai, kimi-coding, ...).
#LLM_PROVIDER=pi
#LLM_MODEL=claude-opus-4-8
#LLM_API_KEY=sk-...
#LLM_BASE_URL=https://api.anthropic.com/v1
#DEEPSEEK_API_KEY=sk-...
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Headless server mode
# ---------------------------------------------------------------------------
# Required when running the standalone server (packages/server).
# Generate one, e.g. `openssl rand -hex 24`:
#CRAFT_SERVER_TOKEN=your-long-random-token
#CRAFT_RPC_HOST=0.0.0.0
#CRAFT_RPC_PORT=9100
# TLS (recommended for non-loopback binds; without TLS a non-loopback bind is refused):
#CRAFT_RPC_TLS_CERT=/path/to/cert.pem
#CRAFT_RPC_TLS_KEY=/path/to/key.pem
#CRAFT_RPC_TLS_CA=/path/to/ca.pem
# Health endpoint port (0 disables):
#CRAFT_HEALTH_PORT=9101
# Web UI + bundled assets (used by install-server.sh / server:dev):
#CRAFT_WEBUI_DIR=./apps/webui/dist
#CRAFT_BUNDLED_ASSETS_ROOT=./apps/electron
#CRAFT_APP_ROOT=/abs/path/to/app-root
#CRAFT_RESOURCES_PATH=/abs/path/to/resources
#CRAFT_IS_PACKAGED=true
#CRAFT_VERSION=0.13.3
# Optional shorter Web UI login password (falls back to CRAFT_SERVER_TOKEN):
#CRAFT_WEBUI_PASSWORD=
#CRAFT_WEBUI_SECURE_COOKIE=true
# Public browser-facing WebSocket URL returned by /api/config:
#CRAFT_WEBUI_WS_URL=wss://your-server:9100
# WhatsApp worker subprocess (default resolves under CRAFT_BUNDLED_ASSETS_ROOT):
#CRAFT_MESSAGING_WA_WORKER=/abs/path/to/worker.cjs
#CRAFT_MESSAGING_NODE_BIN=node
#CRAFT_DISABLE_MESSAGING=1
#CRAFT_LOCAL_MCP_ENABLED=0

# Thin-client mode: point the desktop app at a remote server instead of
# running the embedded server locally.
#CRAFT_SERVER_URL=wss://your-server:9100

# ---------------------------------------------------------------------------
# Paths & runtime
# ---------------------------------------------------------------------------
# Override the config/state directory (default ~/.craft-agent):
#CRAFT_CONFIG_DIR=~/.craft-agent
# WeChat iLink transport state dir (default ~/.craft-agent/wechat):
#CRAFT_WECHAT_STATE_DIR=~/.craft-agent/wechat
# Disable the global fetch interceptor (bun preload) for this process:
#CRAFT_INTERCEPTOR_DISABLE_AUTO_INSTALL=1
# Debug logging (main/server/interceptor):
#CRAFT_DEBUG=1

# ---------------------------------------------------------------------------
# OAuth providers (development fallbacks; production uses source configs)
# ---------------------------------------------------------------------------
# Google OAuth (Desktop app client; used when source config lacks credentials):
#GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
#GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Slack OAuth:
#SLACK_OAUTH_CLIENT_ID=your-slack-client-id
#SLACK_OAUTH_CLIENT_SECRET=your-slack-client-secret

# Microsoft OAuth (PKCE — no client_secret needed):
#MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-client-id

# AWS (Bedrock model fetching / CLI S3 tooling):
#AWS_ACCESS_KEY_ID=...
#AWS_SECRET_ACCESS_KEY=...
#AWS_REGION=us-east-1
#AWS_SESSION_TOKEN=...

# ---------------------------------------------------------------------------
# Error tracking
# ---------------------------------------------------------------------------
# Sentry ingest URL (captures crashes and chat/SDK errors):
# Crash reporting is opt-in; both a DSN and the explicit consent flag are required:
#CRAFT_TELEMETRY_ENABLED=1
#SENTRY_ELECTRON_INGEST_URL=https://your-public-key@o0.ingest.sentry.io/0
#SENTRY_AUTH_TOKEN=...   # build-time sourcemap upload only

# ---------------------------------------------------------------------------
# Tuning knobs (defaults are sane — leave commented)
# ---------------------------------------------------------------------------
# Durable-runtime cutover flags (defaults are conservative):
#CRAFT_DURABLE_SESSION_READ=1
#CRAFT_DURABLE_SESSION_CANARY=1
#CRAFT_TASK_RUN_TIMEOUT_MS=1800000   # TaskRunner wall-clock timeout (default 30 min)
#CRAFT_TRANSFER_TTL_MS=300000        # session-transfer chunk TTL
#CRAFT_BROWSER_OPEN_SETTLE_TIMEOUT_MS=5000
#CRAFT_BROWSER_OPEN_SETTLE_POLL_MS=200
