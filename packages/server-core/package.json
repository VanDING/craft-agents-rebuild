{
  "name": "@craft-agent/server-core",
  "version": "0.13.0",
  "license": "Apache-2.0",
  "description": "Reusable headless server infrastructure for Craft Agent",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./handlers": "./src/handlers/index.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./model-fetchers": "./src/model-fetchers/index.ts",
    "./domain": "./src/domain/index.ts",
    "./services": "./src/services/index.ts",
    "./handlers/rpc": "./src/handlers/rpc/index.ts",
    "./handlers/rpc/*": "./src/handlers/rpc/*.ts",
    "./sessions": "./src/sessions/index.ts",
    "./durable-runtime": "./src/durable-runtime/index.ts",
    "./tasks": "./src/tasks/index.ts",
    "./webui": "./src/webui/index.ts"
  },
  "scripts": {
    "typecheck": "bun run tsc --noEmit"
  },
  "dependencies": {
    "@craft-agent/core": "workspace:*",
    "@craft-agent/shared": "workspace:*",
    "@earendil-works/pi-ai": "0.85.1",
    "jose": "^6.2.12",
    "markitdown-js": "^0.0.14",
    "openai": "^7.10.0",
    "sharp": "0.35.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
